{
    "name": "sushimoo/laravel-api",
    "type": "project",
    "description": "SUSHIMOO POS - Japanese Restaurant Point of Sale REST API",
    "keywords": ["pos", "restaurant", "laravel", "sanctum"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/agent-detector": "*",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "psy/psysh": "^0.12.24"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^11.0",
        "symfony/process": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
        "post-update-cmd": "Illuminate\\Foundation\\ComposerScripts::postUpdate",
        "test": "@php artisan test"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pint": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
